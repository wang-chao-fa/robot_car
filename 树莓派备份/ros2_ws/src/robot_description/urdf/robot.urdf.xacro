<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_car">

  <!-- 1. 物理尺寸常数 (实测精准数据) -->
  <xacro:property name="wheel_track"  value="0.405" />
  <xacro:property name="wheel_radius" value="0.108"  />
  <xacro:property name="wheel_length" value="0.04"   />
  <xacro:property name="base_length"  value="0.66"   />
  <xacro:property name="base_width"   value="0.342"  />
  <xacro:property name="base_height"  value="0.07"   />

  <!-- X 轴位置 (底盘中心为原点, 前方 +X, 两个差速轮那端是前方) -->
  <xacro:property name="laser_x"        value="0.272"  />
  <xacro:property name="wheel_x"        value="0.252"  />
  <xacro:property name="imu_x"          value="0.203"  />
  <xacro:property name="camera_board_x" value="0.105"  />
  <xacro:property name="caster_x"       value="-0.146" />

  <!-- 2. 颜色定义 -->
  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="blue"><color rgba="0.1 0.4 0.8 1.0"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>
  <material name="wood_brown"><color rgba="0.6 0.4 0.2 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>

  <!-- 3. Base Footprint -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- 4. Base Link 车体底盘 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- 5. 左差速驱动轮 -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="${wheel_x} ${wheel_track/2.0} 0" rpy="0 0 0"/>
  </joint>

  <!-- 6. 右差速驱动轮 -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="${wheel_x} ${-wheel_track/2.0} 0" rpy="0 0 0"/>
  </joint>

  <!-- 7. 后万向轮支架 -->
  <link name="caster_bracket_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.0215"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </link>
  <joint name="caster_bracket_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_bracket_link"/>
    <origin xyz="${caster_x} 0 ${-base_height/2.0 - 0.01075}" rpy="0 0 0"/>
  </joint>

  <!-- 8. 后万向轮球 -->
  <link name="caster_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="caster_bracket_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="0 0 ${-0.01075 - 0.025}" rpy="0 0 0"/>
  </joint>

  <!-- 9. 万集 719C 激光雷达 -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="${laser_x} 0.0 ${base_height/2.0 + 0.025}" rpy="0 0 0"/>
  </joint>

  <!-- 10. IMU 惯导 -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.04 0.01"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} 0.0 ${base_height/2.0 + 0.005}" rpy="0 0 0"/>
  </joint>

  <!-- 11. 相机木板立柱 -->
  <link name="camera_support_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.06 0.53"/>
      </geometry>
      <material name="wood_brown"/>
    </visual>
  </link>
  <joint name="camera_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_support_link"/>
    <origin xyz="${camera_board_x} 0.0 ${base_height/2.0 + 0.265}" rpy="0 0 0"/>
  </joint>

  <!-- 12. Iris 3D 深度相机 -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.08 0.05"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="camera_support_link"/>
    <child link="camera_link"/>
    <origin xyz="0.03 0.0 ${0.265 - 0.058}" rpy="0 0 0"/>
  </joint>

</robot>
